// Firestore security rules for Binger. Paste these into the Firebase console
// (Firestore Database → Rules → Publish). See docs/FIREBASE.md.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Which household you belong to: only you can read or change it.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /households/{code} {
      function signedIn() { return request.auth != null; }
      function isMember() { return signedIn() && request.auth.uid in resource.data.members; }

      allow read: if isMember();
      // You can start a household with only yourself in it.
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      // Members can change it. Anyone signed in who has the invite code can
      // add themselves, and only themselves, and change nothing else.
      allow update: if isMember() || (signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.auth.uid in request.resource.data.members);

      // Each person's library: readable and writable by household members.
      match /profiles/{profileId} {
        allow read, write: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/households/$(code)).data.members;
      }
    }
  }
}
